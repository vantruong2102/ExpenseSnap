# Copy thành .env.test (hoặc đặt biến môi trường) rồi chạy: pytest -v
GATEWAY_URL=http://127.0.0.1:8000
# Phải trùng JWT_SIGNING_KEY trong Backend/.env
JWT_SIGNING_KEY=change-me-too
# id của một User có thật trong auth DB (xem /api/auth/me/ sau khi đăng nhập app) – dùng cho test /me, /overview, refresh
TEST_USER_ID=1
# (tùy chọn) đăng nhập Firebase thật để test luồng POST /api/auth/firebase/
FIREBASE_WEB_API_KEY=
TEST_EMAIL=
TEST_PASSWORD=
# Đặt =1 khi đã TẮT receipt-service để chạy test chịu lỗi (TC-GW-06)
RECEIPT_DOWN=0
