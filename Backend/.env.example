# Copy file này thành .env và điền giá trị thật. KHÔNG commit file .env.
# Mọi service (gateway, auth, receipt, registry) cùng đọc file này.
# Tạo khóa ngẫu nhiên bằng lệnh:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Danh sách host, cách nhau bởi dấu phẩy (10.0.2.2 = máy tính khi gọi từ Android emulator)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# Khóa ký JWT: auth-service dùng để ký, các service khác dùng để kiểm tra token
JWT_SIGNING_KEY=change-me-too
# Token nội bộ để service được phép đăng ký với Service Registry
SERVICE_REGISTRY_TOKEN=change-me-three

# Địa chỉ và cổng của từng service
SERVICE_REGISTRY_URL=http://127.0.0.1:8010
SERVICE_HOST=127.0.0.1
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
RECEIPT_SERVICE_PORT=8002
REGISTRY_SERVICE_PORT=8010
